local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, 
            startPos.X.Offset + delta.X, 
            startPos.Y.Scale, 
            startPos.Y.Offset + delta.Y
        )
    end
end)

local AUTO_FARM_ENABLED = false
local LAG_REDUCE_ENABLED = false
local SPAWN_BASE_POS = Vector3.new(-23, 3, -38)
local FARM_AREA_POS = Vector3.new(79, 3, 6155)

local function getRootPart()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return character:WaitForChild("HumanoidRootPart", 5)
end

local function getHumanoid()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return character:WaitForChild("Humanoid", 5)
end

local function toggleFarm()
    AUTO_FARM_ENABLED = not AUTO_FARM_ENABLED
    
    if AUTO_FARM_ENABLED then
        ToggleBtn.Text = "Farm: ON"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
    else
        ToggleBtn.Text = "Farm: OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end

local function toggleLagReduce()
    LAG_REDUCE_ENABLED = not LAG_REDUCE_ENABLED
    
    if LAG_REDUCE_ENABLED then
        LagBtn.Text = "White Screen: ON [V]"
        LagBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        pcall(function()
            settings():GetService("RenderSettings").QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            for _, v in ipairs(Workspace:GetDescendants()) do
                if v:IsA("BasePart") then
                    v.Material = Enum.Material.SmoothPlastic
                    v.Reflectance = 0
                end
            end
        end)
    else
        LagBtn.Text = "White Screen: OFF [V]"
        LagBtn.BackgroundColor3 = Color3.fromRGB(50, 100, 200)
        pcall(function()
            Lighting.GlobalShadows = true
            settings():GetService("RenderSettings").QualityLevel = Enum.QualityLevel.Automatic
        end)
    end
end

task.spawn(function()
    while true do
        if AUTO_FARM_ENABLED then
            pcall(function()
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if not AUTO_FARM_ENABLED then break end
                    if v.Name:lower():find("cash") or v.Name:lower():find("money") then
                        if v:IsA("BasePart") then
                            local rootPart = getRootPart()
                            if rootPart then
                                local oldPos = rootPart.CFrame
                                rootPart.CFrame = v.CFrame
                                task.wait(0.4)
                                rootPart.CFrame = oldPos
                                task.wait(0.3)
                            end
                        end
                    end
                end

                local rootPart = getRootPart()
                if rootPart and AUTO_FARM_ENABLED then
                    rootPart.CFrame = CFrame.new(FARM_AREA_POS)
                    task.wait(1.5)
                    
                    local collectedAny = true
                    local loops = 0
                    
                    while AUTO_FARM_ENABLED and collectedAny and loops < 10 do
                        collectedAny = false
                        loops = loops + 1
                        
                        for _, obj in ipairs(Workspace:GetDescendants()) do
                            if not AUTO_FARM_ENABLED then break end
                            
                            if obj:IsA("BasePart") and (obj.Position - FARM_AREA_POS).Magnitude < 80 then
                                local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt") or obj.Parent:FindFirstChildWhichIsA("ProximityPrompt")
                                
                                if prompt and prompt.Enabled then
                                    collectedAny = true
                                    rootPart.CFrame = obj.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.5)
                                    
                                    pcall(function()
                                        fireproximityprompt(prompt)
                                    end)
                                    task.wait(0.6)
                                end
                            end
                        end
                        task.wait(0.5)
                    end
                end

                if AUTO_FARM_ENABLED and rootPart then
                    rootPart.CFrame = CFrame.new(SPAWN_BASE_POS)
                    task.wait(1.0)
                    
                    pcall(function()
                        for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                            if gui:IsA("TextButton") or gui:IsA("ImageButton") then
                                local name = gui.Name:lower()
                                if name:find("best") or name:find("place") or name:find("auto") then
                                    firesignal(gui.MouseButton1Click)
                                end
                            end
                        end
                    end)
                    
                    local humanoid = getHumanoid()
                    for i = 1, 5 do
                        if not AUTO_FARM_ENABLED then break end
                        
                        if humanoid then
                            humanoid.Jump = true
                        end
                        
                        if i == 2 then
                            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 0, 3)
                        elseif i == 4 then
                            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, 0, -3)
                        end
                        
                        task.wait(1)
                    end
                end
            end)
        end
        task.wait(2)
    end
end)

ToggleBtn.MouseButton1Click:Connect(toggleFarm)
LagBtn.MouseButton1Click:Connect(toggleLagReduce)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed then
        if input.KeyCode == Enum.KeyCode.B then
            toggleFarm()
        elseif input.KeyCode == Enum.KeyCode.V then
            toggleLagReduce()
        end
    end
end)

